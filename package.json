{
  "name": "idy-pi-skills",
  "version": "0.1.0",
  "description": "Pi skills collection with evidence-based visual acceptance for real apps",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "skills",
    "visual-acceptance"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/idy/skill.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "visual-acceptance": "scripts/visual-acceptance.mjs"
  },
  "files": [
    "README.md",
    "docs/",
    "schemas/",
    "scripts/",
    "extensions/",
    "skills/",
    "examples/"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./extensions/visual-acceptance.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs skills/visual-acceptance/review/tests/*.test.mjs skills/visual-acceptance/adapters/device-hub/*.test.mjs",
    "test:browser": "node --test skills/visual-acceptance/review/tests/browser/review-ui.browser.mjs",
    "browser:install": "playwright install chromium",
    "check:schema": "node scripts/validate-recording.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "playwright": "1.65.1"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
