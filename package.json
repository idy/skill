{
  "name": "idy-skill-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Source workspace for independently installable Pi skills",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/idy/skill.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": ["packages/*"],
  "pi": {
    "skills": ["./packages/visual-acceptance/skills/visual-acceptance"],
    "extensions": ["./packages/visual-acceptance/extensions/visual-acceptance.ts"]
  },
  "bin": {
    "visual-acceptance": "packages/visual-acceptance/scripts/visual-acceptance.mjs"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present && npm run test:packaging",
    "test:packaging": "node --test tests/packaging.test.mjs",
    "check": "npm run check --workspaces --if-present",
    "check:schema": "npm run check:schema --workspace=pi-visual-acceptance",
    "test:browser": "npm run test:browser --workspace=pi-visual-acceptance",
    "browser:install": "npm run browser:install --workspace=pi-visual-acceptance",
    "demo-export": "node packages/visual-acceptance/scripts/visual-acceptance.mjs demo-export",
    "pack:visual-acceptance": "npm pack --workspace=pi-visual-acceptance --ignore-scripts"
  }
}
