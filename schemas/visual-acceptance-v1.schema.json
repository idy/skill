{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/idy/skill/schemas/visual-acceptance-v1.schema.json",
  "title": "Visual acceptance v1 exchange contracts",
  "description": "Select a $defs entry for each exchange. Runtime enforces references, hashes, decode, stale rules, receipt sequence and budgets in addition to JSON shape.",
  "$defs": {
    "reviewProtocol": {"const":"visual-acceptance-2"},
    "id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "time": {"type":"string","format":"date-time"},
    "verdict": {"enum":["pass","question","fail"]},
    "labels": {"type":"array","items":{"type":"object","required":["id","label"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"type":"string","minLength":1}}}},
    "policy": {"type":"object","required":["revision","maxRepairRounds","captureRetries","maxMinutes","maxImages"],"properties":{"revision":{"$ref":"#/$defs/id"},"maxRepairRounds":{"type":"integer","minimum":0,"default":2},"captureRetries":{"type":"integer","minimum":0,"default":1},"maxMinutes":{"type":"number","exclusiveMinimum":0,"default":30},"maxImages":{"type":"integer","minimum":0,"default":80}}},
    "cell": {"type":"object","required":["scenarioId","stateId","deviceId","orientation","variantId","checkpoints"],"properties":{"id":{"$ref":"#/$defs/id"},"scenarioId":{"$ref":"#/$defs/id"},"stateId":{"$ref":"#/$defs/id"},"deviceId":{"$ref":"#/$defs/id"},"variantId":{"$ref":"#/$defs/id"},"orientation":{"enum":["portrait","landscape","unspecified"]},"checkpoints":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}},
    "spec": {"type":"object","required":["revision","scenarios","states","devices","variants","cells"],"properties":{"revision":{"$ref":"#/$defs/id"},"scenarios":{"$ref":"#/$defs/labels"},"devices":{"$ref":"#/$defs/labels"},"variants":{"$ref":"#/$defs/labels"},"states":{"type":"array","items":{"type":"object","required":["id","label","kind"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"type":"string","minLength":1},"kind":{"enum":["state","transition"]},"fromStateId":{"$ref":"#/$defs/id"},"toStateId":{"$ref":"#/$defs/id"}},"allOf":[{"if":{"properties":{"kind":{"const":"transition"}}},"then":{"required":["fromStateId","toStateId"]}}]}},"cells":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/cell"}}}},
    "projectInput": {"type":"object","required":["schemaVersion","project","spec"],"properties":{"schemaVersion":{"const":1},"project":{"type":"object","required":["id","name"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"type":"string","minLength":1}}},"spec":{"$ref":"#/$defs/spec"},"policy":{"type":"object","description":"Policy fields may be omitted to use defaults."}}},
    "target": {"type":"object","required":["buildId","runtimeId","specRev"],"properties":{"buildId":{"$ref":"#/$defs/id"},"runtimeId":{"$ref":"#/$defs/id"},"specRev":{"$ref":"#/$defs/id"}}},
    "buildInput": {"type":"object","required":["id","sourceSnapshotId","artifact","platform","command","createdAt","immutable"],"properties":{"id":{"$ref":"#/$defs/id"},"sourceSnapshotId":{"$ref":"#/$defs/id"},"artifact":{"type":"object","required":["path"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256"}}},"platform":{"type":"string","minLength":1},"command":{"type":"string","minLength":1},"createdAt":{"$ref":"#/$defs/time"},"immutable":{"const":true}}},
    "runtimeInput": {"type":"object","required":["id","buildId","adapter","app","fixture","environment","immutable","driftDetected","limitations"],"properties":{"id":{"$ref":"#/$defs/id"},"buildId":{"$ref":"#/$defs/id"},"adapter":{"type":"object","required":["name","version"],"properties":{"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1}}},"app":{"type":"object","required":["id","version"],"properties":{"id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1}}},"fixture":{"type":"object","required":["id","version","mode","description"],"properties":{"id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"mode":{"enum":["none","controlled-io"]},"description":{"type":"string","minLength":1}}},"environment":{"type":"object"},"immutable":{"type":"boolean"},"driftDetected":{"type":"boolean"},"limitations":{"type":"array","items":{"type":"string"}}}},
    "assetInput": {"type":"object","required":["id","kind","path","capturedAt"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["screenshot","frame","video"]},"path":{"type":"string","minLength":1},"capturedAt":{"$ref":"#/$defs/time"},"sha256":{"$ref":"#/$defs/sha256"},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"offsetMs":{"type":"number","minimum":0},"durationMs":{"type":"number","exclusiveMinimum":0}},"allOf":[{"if":{"properties":{"kind":{"enum":["screenshot","frame"]}}},"then":{"required":["width","height"]}},{"if":{"properties":{"kind":{"const":"video"}}},"then":{"required":["durationMs"]}}]},
    "action": {"type":"object","required":["at","type","description","source"],"properties":{"at":{"$ref":"#/$defs/time"},"type":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"source":{"type":"string","minLength":1}}},
    "assertion": {"type":"object","required":["description","result","basis","evidenceAssetIds"],"properties":{"stateId":{"$ref":"#/$defs/id"},"description":{"type":"string","minLength":1},"result":{"enum":["pass","fail","unknown"]},"basis":{"enum":["visual","accessibility","runtime","api"]},"evidenceAssetIds":{"type":"array","items":{"$ref":"#/$defs/id"}}}},
    "captureInput": {"type":"object","required":["id","cellId","sourceSnapshotId","buildId","runtimeId","specRev","createdAt","status","assets","actions","assertions","provenance","limitations","blockers"],"properties":{"id":{"$ref":"#/$defs/id"},"cellId":{"$ref":"#/$defs/id"},"sourceSnapshotId":{"$ref":"#/$defs/id"},"buildId":{"$ref":"#/$defs/id"},"runtimeId":{"$ref":"#/$defs/id"},"specRev":{"$ref":"#/$defs/id"},"createdAt":{"$ref":"#/$defs/time"},"status":{"enum":["captured","blocked"]},"assets":{"type":"array","items":{"$ref":"#/$defs/assetInput"}},"actions":{"type":"array","items":{"$ref":"#/$defs/action"}},"assertions":{"type":"array","items":{"$ref":"#/$defs/assertion"}},"provenance":{"type":"object","required":["adapter","adapterVersion","deviceId","deviceKind","source","fixtureDescription"],"properties":{"adapter":{"type":"string","minLength":1},"adapterVersion":{"type":"string","minLength":1},"deviceId":{"type":"string","minLength":1},"deviceKind":{"type":"string","minLength":1},"source":{"const":"real-app"},"fixtureDescription":{"type":"string","minLength":1}}},"limitations":{"type":"array","items":{"type":"string"}},"blockers":{"type":"array","items":{"type":"string"}},"transition":{"type":"object","required":["fromStateId","toStateId","startedAt","endedAt","triggerActionIndex","startEvidenceAssetId","endEvidenceAssetId"],"properties":{"triggerActionIndex":{"type":"integer","minimum":0},"startEvidenceAssetId":{"$ref":"#/$defs/id"},"endEvidenceAssetId":{"$ref":"#/$defs/id"},"fromStateId":{"$ref":"#/$defs/id"},"toStateId":{"$ref":"#/$defs/id"},"startedAt":{"$ref":"#/$defs/time"},"endedAt":{"$ref":"#/$defs/time"}}}}},
    "asset": {"type":"object","required":["id","kind","path","capturedAt","sha256","mimeType","bytes"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["screenshot","frame","video"]},"path":{"type":"string","pattern":"^evidence/[a-f0-9]{64}\\.(png|jpg|mp4|webm)$"},"capturedAt":{"$ref":"#/$defs/time"},"sha256":{"$ref":"#/$defs/sha256"},"mimeType":{"enum":["image/png","image/jpeg","video/mp4","video/webm"]},"pixelSha256":{"$ref":"#/$defs/sha256","description":"Optional core-derived canonical decoded dimensions/RGBA8 digest; never a substitute for encoded-file SHA integrity."},"bytes":{"type":"integer","minimum":1},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"offsetMs":{"type":"number","minimum":0},"durationMs":{"type":"number","exclusiveMinimum":0}}},
    "feedbackEdit": {"type":"object","required":["cellId","captureId","buildId","runtimeId","specRev","verdict","comment","reviewer"],"properties":{"cellId":{"$ref":"#/$defs/id"},"captureId":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"buildId":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"runtimeId":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"specRev":{"$ref":"#/$defs/id"},"verdict":{"$ref":"#/$defs/verdict"},"comment":{"type":"string","maxLength":16000},"reviewer":{"type":"string","minLength":1,"maxLength":16000}}},
    "feedbackBatch": {"type":"object","required":["schemaVersion","batchId","projectId","sourceId","submittedAt","edits"],"properties":{"schemaVersion":{"const":1},"batchId":{"$ref":"#/$defs/id"},"projectId":{"$ref":"#/$defs/id"},"sourceId":{"$ref":"#/$defs/id"},"submittedAt":{"$ref":"#/$defs/time"},"edits":{"type":"array","minItems":1,"maxItems":1000,"items":{"$ref":"#/$defs/feedbackEdit"}}}},
    "draft": {"type":"object","required":["schemaVersion","projectId","sourceId","edits"],"properties":{"schemaVersion":{"const":1},"projectId":{"$ref":"#/$defs/id"},"sourceId":{"$ref":"#/$defs/id"},"edits":{"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/feedbackEdit"}},"savedAt":{"$ref":"#/$defs/time"}}},
    "aiReviewInput": {"type":"object","required":["cellId","captureId","verdict","comment","visibleText","observations","receiptIds"],"properties":{"cellId":{"$ref":"#/$defs/id"},"captureId":{"$ref":"#/$defs/id"},"verdict":{"$ref":"#/$defs/verdict"},"comment":{"type":"string","minLength":1,"maxLength":16000},"visibleText":{"type":"array","items":{"type":"string","minLength":1}},"observations":{"type":"array","minItems":1,"items":{"type":"object","required":["assetId","sha256","detail"],"properties":{"assetId":{"$ref":"#/$defs/id"},"sha256":{"$ref":"#/$defs/sha256"},"detail":{"type":"string","minLength":1}}}},"receiptIds":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/id"}}}},
    "viewModel": {"type":"object","required":["schemaVersion","project","spec","target","policy","generatedAt","cells","storage"],"properties":{"schemaVersion":{"const":1},"project":{"type":"object","required":["id","name"]},"spec":{"$ref":"#/$defs/spec"},"target":{"anyOf":[{"$ref":"#/$defs/target"},{"type":"null"}]},"policy":{"$ref":"#/$defs/policy"},"generatedAt":{"$ref":"#/$defs/time"},"reviewProtocol":{"$ref":"#/$defs/reviewProtocol"},"cells":{"type":"array","items":{"allOf":[{"$ref":"#/$defs/cell"},{"type":"object","required":["id","status","staleReasons","capture","captures","aiReviews","humanReviews","currentAIReview","currentHumanReview"],"properties":{"status":{"enum":["missing","blocked","stale","unreviewed","pass","question","fail"]},"staleReasons":{"type":"array","items":{"type":"string"}},"capture":{"type":["object","null"]},"captures":{"type":"array"},"aiReviews":{"type":"array"},"humanReviews":{"type":"array"},"currentAIReview":{"type":["object","null"]},"currentHumanReview":{"type":["object","null"]}}}]}},"storage":{"type":"object","required":["mode","drafts","collaboration"],"properties":{"mode":{"const":"local-single-reviewer"},"drafts":{"type":"string"},"collaboration":{"const":false}}}}}
  }
}
